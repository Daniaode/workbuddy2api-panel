# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
/probe_bin

# Config with secrets (use config.example.json)
config.json
# 本地配置备份（含 api_key，绝不入库）
config.json.bak-*

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
# docs/ 下的设计/计划文档不进版本库，但「官方客户端对照」是长期维护依据，必须进。
# 两条注意：
#   1) 不能写成 `docs/` —— 目录整体被排除后，目录内的 ! 例外不生效；
#   2) 例外必须排在 `*.md` **之后** —— gitignore 按顺序生效，
#      先写的 ! 会被后写的通配规则重新忽略。
docs/*
*.md
!README.md
!docs/official-client.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
.DS_Store

# Spike 的 Go 构建缓存（不入库）
.gocache/
